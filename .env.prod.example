# Copy to `.env` ON THE BOX and fill in. Never commit it.
#
# Read by docker compose (docker-compose.yml + docker-compose.prod.yml), by deploy.sh and by
# scripts/backup-db.sh. Every one of these is required: the backend throws on a missing variable
# rather than booting broken (backend/.../config/Env.kt), and compose refuses to start without them.

# --- the two hostnames -------------------------------------------------------------------------
# Where the API lives. Caddy asks Let's Encrypt for a certificate for exactly this name, so its A
# record must already point at the box.
API_DOMAIN=api.sharpeyes.gg

# Where the frontend lives (Vercel). This is the ONLY origin the backend's CORS will accept.
# Note: allowHost strips the scheme and matches host AND port, so include a port if there is one.
FRONTEND_ORIGIN=https://sharpeyes.gg

# --- database ----------------------------------------------------------------------------------
# Postgres runs as a container on this box. DB_HOST/DB_PORT/DB_NAME come from docker-compose.yml
# and do not belong here; only the credentials do.
#
# Generate: openssl rand -base64 32
DB_USERNAME=maplestorage
DB_PASSWORD=

# --- Clerk -------------------------------------------------------------------------------------
# The backend verifies every request's JWT against this JWKS. Without it, it 401s everything, which
# the UI reports as "Upload failed. Check your connection" and sends you to debug your network.
# The domain is not a secret: it is base64-encoded inside the frontend's publishable key.
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# --- backups -----------------------------------------------------------------------------------
# From `terraform output` in infra/. The key is PutObject-only and scoped to this one bucket, so it
# can neither read nor delete what it writes.
BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
