# Copy to .env (gitignored) and fill in real values.
# These 5 DB_* names match 1:1 with what infra/ecs.tf injects into the ECS
# task in prod (DB_HOST/DB_PORT/DB_NAME as plain env vars, DB_USERNAME/
# DB_PASSWORD from Secrets Manager) -- Env.kt reads all five identically via
# System.getenv, so no code needs to know it's running locally vs in ECS.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=maplestorage
DB_USERNAME=maplestorage
DB_PASSWORD=maplestorage

CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
FRONTEND_ORIGIN=http://localhost:3000

# Screenshot parsing (M3). ANTHROPIC_MODEL is optional -- defaults to
# claude-sonnet-5 (see Env.kt).
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5
