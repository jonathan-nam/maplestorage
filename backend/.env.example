# Copy to .env (gitignored):  cp backend/.env.example backend/.env
#
# Everything below works as-is against the local stack in docker-compose.yml.
#
# The 5 DB_* names are the ones docker-compose.prod.yml sets on the box, so Env.kt reads
# them identically either way and no code needs to know where it is running.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sharpeyes
DB_USERNAME=sharpeyes
DB_PASSWORD=sharpeyes

# The auth service (see auth/). AUTH_ISSUER has to be the string it puts in `iss`, which is
# its own AUTH_BASE_URL, and AUTH_AUDIENCE has to match its AUTH_AUDIENCE.
#
# Getting any of these wrong does NOT fail loudly. The backend boots fine and then 401s every
# request, and the UI reports that as "Upload failed, check your connection" -- which
# sends you looking at your network. If everything 401s, suspect this first.
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=sharpeyes-api

FRONTEND_ORIGIN=http://localhost:3000

# ANTHROPIC_API_KEY used to live here. It is gone, and you do not need one: screenshots
# are parsed by the local OpenCV service in vision/. No model is called, nothing is
# metered, and the backend no longer reads an Anthropic key at all.
