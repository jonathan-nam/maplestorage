# Copy to .env (gitignored):  cp backend/.env.example backend/.env
#
# Only one value below actually needs finding. The rest work as-is against the local
# Postgres in docker-compose.yml.
#
# The 5 DB_* names match 1:1 with what infra/ecs.tf injects into the ECS task in prod
# (DB_HOST/DB_PORT/DB_NAME as plain env vars, DB_USERNAME/DB_PASSWORD from Secrets
# Manager) -- Env.kt reads all five identically via System.getenv, so no code needs to
# know whether it is running locally or in ECS.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=maplestorage
DB_USERNAME=maplestorage
DB_PASSWORD=maplestorage

# The one you have to go and get: Clerk dashboard -> your instance -> API keys.
#
# Getting this wrong does NOT fail loudly. The backend boots fine and then 401s every
# request, and the UI reports that as "Upload failed, check your connection" -- which
# sends you looking at your network. If everything 401s, suspect this first.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

FRONTEND_ORIGIN=http://localhost:3000

# ANTHROPIC_API_KEY used to live here. It is gone, and you do not need one: screenshots
# are parsed by the local OpenCV service in vision/. No model is called, nothing is
# metered, and the backend no longer reads an Anthropic key at all.
